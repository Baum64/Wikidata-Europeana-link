# Europeana Entity API – persönlicher Schlüssel: https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=
# Für die öffentlichen DDB-Endpunkte nicht nötig (nur für Favoriten/User-API)
DDB_API_KEY=
# Kontakt für den User-Agent (Wikimedia-Policy); leer = Projekt-Repository
GLAMSYNC_CONTACT=https://github.com/Baum64/Wikidata-Europeana-link
# Lebensdauer des Wikidata-Caches in Stunden (danach werden Wikidata-Daten neu geladen)
GLAMSYNC_WIKIDATA_CACHE_HOURS=12
# GND-Dump Körperschaften (lokal, nicht im Repo), z. B. data/gnd/authorities-gnd-koerperschaft_lds_20261013.jsonld.gz
# Sachbegriff- und Geografikum-Dump werden im selben Ordner gesucht.
GND_DUMP_PATH=
# GND-Umlenkungen/-Löschungen (monatlich), z. B. data/gnd/authorities-gnd_umlenk_loesch_20261113.jsonld.gz
# Leer: die neueste authorities-gnd_umlenk_loesch_*.jsonld.gz neben GND_DUMP_PATH.
GND_REDIRECTS_PATH=
